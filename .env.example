# Saathi CRM environment variables.
# Copy to .env.local and fill in. .env.local is gitignored.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
# local | modal | mock     (mock is for unit tests only)
AI_MODE=local

# Local Gemma 4 endpoint via Cloudflare Tunnel
GEMMA_ENDPOINT_URL=
GEMMA_MODEL=

# Modal serverless backup
MODAL_GEMMA_URL=

# --- ASR ---
# AI4Bharat IndicConformer URL (HF Inference Endpoint or self-hosted)
INDIC_CONFORMER_URL=

# --- WhatsApp Business Cloud API ---
WHATSAPP_BUSINESS_PHONE_ID=
WHATSAPP_BUSINESS_TOKEN=
WHATSAPP_BUSINESS_VERIFY_TOKEN=
