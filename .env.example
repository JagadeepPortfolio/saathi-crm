# Saathi CRM environment variables.
# Copy to .env.local and fill in. .env.local is gitignored.
# This file is a template — never paste real values here.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
# Use the SECRET key (sb_secret_* or legacy service-role JWT). NOT the publishable key.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI ---
# local | modal | mock     (mock is unit-test only, never the demo default)
AI_MODE=local

# Local Gemma 4 endpoint via Cloudflare Tunnel (Day 2)
GEMMA_ENDPOINT_URL=
GEMMA_MODEL=

# Modal serverless backup (Day 9)
MODAL_GEMMA_URL=

# --- ASR ---
# AI4Bharat IndicConformer URL (HF Inference Endpoint or self-hosted) (Day 2)
INDIC_CONFORMER_URL=

# --- WhatsApp ---
# Provider-agnostic adapter; pilot uses Twilio Sandbox.
# Switch to "meta" for production by setting WHATSAPP_PROVIDER and the meta-* keys.
WHATSAPP_PROVIDER=twilio

# Twilio WhatsApp Sandbox (Day 1)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Verify token for inbound webhook (any string you choose; same value goes in the provider console)
WHATSAPP_VERIFY_TOKEN=

# Meta WhatsApp Business Cloud API (production swap path; not needed for hackathon demo)
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_TOKEN=
