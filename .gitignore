# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — only the example template is committed
.env
.env.local
.env*.local
.env.production*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Day 2: model files (large, downloaded on demand)
/models/
/samples/*.wav
/samples/*.txt

# Video build intermediates (regenerated by video/build.sh)
/video/clips/
/video/audio/
# The final mp4 (video/output/submission.mp4) IS tracked so a stranger can
# watch the demo without rebuilding it.
